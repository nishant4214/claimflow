{
  "name": "NotificationConfig",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "CLAIM_APPROVED",
        "CLAIM_REJECTED",
        "CLAIM_SENT_BACK",
        "ROOM_APPROVED",
        "ROOM_REJECTED",
        "ROOM_SENT_BACK",
        "TRANSPORT_APPROVED",
        "TRANSPORT_REJECTED",
        "TRANSPORT_SENT_BACK"
      ],
      "description": "Event that triggers notification"
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this notification is sent"
    },
    "email_template_id": {
      "type": "string",
      "description": "Reference to EmailTemplate entity"
    },
    "send_to_recipient": {
      "type": "boolean",
      "default": true,
      "description": "Send to claim/request employee"
    },
    "send_to_manager": {
      "type": "boolean",
      "default": false,
      "description": "Send to employee's manager"
    },
    "send_to_approver": {
      "type": "boolean",
      "default": false,
      "description": "Send to approver who took action"
    },
    "additional_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of email addresses to CC"
    },
    "delay_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minutes to delay sending (0 = immediate)"
    },
    "retry_count": {
      "type": "number",
      "default": 3,
      "description": "Number of times to retry if send fails"
    },
    "description": {
      "type": "string",
      "description": "Admin notes about this notification"
    }
  },
  "required": [
    "event_type"
  ]
}