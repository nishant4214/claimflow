{
  "name": "MainClaim",
  "type": "object",
  "properties": {
    "claim_number": {
      "type": "string",
      "description": "Auto-generated: CLM-YYYY-NNNN"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "expense_date_from": {
      "type": "string",
      "format": "date"
    },
    "expense_date_to": {
      "type": "string",
      "format": "date"
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "categories_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "partially_approved",
        "approved",
        "rejected"
      ],
      "default": "draft"
    },
    "payment_mode": {
      "type": "string"
    },
    "payment_reference": {
      "type": "string"
    },
    "payment_remarks": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "Manual",
        "Bulk Upload"
      ],
      "default": "Manual"
    }
  },
  "required": [
    "employee_name",
    "employee_email",
    "expense_date_from",
    "expense_date_to"
  ]
}