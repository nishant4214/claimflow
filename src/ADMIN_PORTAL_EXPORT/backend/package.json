{
  "name": "admin-portal-backend",
  "version": "1.0.0",
  "description": "Independent Admin Portal Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:db": "node -e \"const db = require('./config/database'); db.query('SELECT NOW()', (err) => { if(err) console.error('✗ DB Error:', err.message); else console.log('✓ Database connected'); process.exit(0); })\"",
    "migrate": "psql $DATABASE_URL < ../DATABASE_SETUP.sql",
    "seed": "node scripts/seedData.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": ["admin", "portal", "backend"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.2",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}